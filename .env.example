# Listing Optimizer — copy to .env and fill in. .env is gitignored; never commit it.

AIRROI_API_KEY=          # used by: pull_comps (competitor comps) — get one at https://www.airroi.com/api/developer/activate
GEMINI_API_KEY=          # used by: analyze_photos (photo scoring) — https://aistudio.google.com/apikey
HOSPITABLE_TOKEN=        # used by: hospitable_api.py (your listings) — ONLY needed if you have no Hospitable MCP server. my.hospitable.com → Apps → API access

# Optional overrides (defaults shown — leave commented unless you need them):
# AIRROI_BASE_URL=https://api.airroi.com
# AIRROI_TIMEOUT=30
# GEMINI_MODEL=gemini-2.5-flash
