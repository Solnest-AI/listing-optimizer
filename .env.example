# Listing Optimizer — copy this file to .env and fill in your keys.
# .env is gitignored; never commit or share it.
# Put each key directly after the = sign, nothing else on the line.

# Competitor comps (required) — get a key at https://www.airroi.com/api/developer/activate
AIRROI_API_KEY=

# Photo scoring (required) — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Your PMS — fill in the ONE that applies:
# • Hospitable (built-in, easiest): my.hospitable.com → Apps → API access → Platform token
HOSPITABLE_TOKEN=

# • Any other PMS (Hostaway, Guesty, OwnerRez, Lodgify, Smoobu, ...): its API token from
#   your PMS account/developer settings. Claude maps its API to the data contract in CLAUDE.md.
# PMS_NAME=
# PMS_TOKEN=
# PMS_BASE_URL=

# • No PMS? Stage the JSON contract from the skill by hand; there is no Airbnb URL importer.

# Live Airbnb gallery: the photo plan uses the photos guests actually see, not your PMS copy.
# If RankBreeze or IntelliHost is already connected in Claude Code, it is found automatically
# and you can leave these blank. Fill one in only to override. RankBreeze is used first.
# • RankBreeze: the MCP server address RankBreeze gives you to connect it to Claude
#   (https://app.rankbreeze.com/api/mcp/rb_mcp_...). The address itself is the key.
RANKBREEZE_MCP_URL=
# • IntelliHost (Premium): an MCP access token from your IntelliHost account.
INTELLIHOST_MCP_TOKEN=

# Optional overrides (defaults shown):
# AIRROI_BASE_URL=https://api.airroi.com
# AIRROI_TIMEOUT=30
# GEMINI_MODEL=gemini-2.5-flash
