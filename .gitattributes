# Keep LF everywhere, including Windows checkouts with core.autocrlf=true.
# The writer agent is generated from SKILL.md byte-for-byte; CRLF breaks that check.
* text=auto eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.pdf binary
# Batch files must keep CRLF or cmd.exe can misparse them.
*.cmd text eol=crlf
*.bat text eol=crlf
