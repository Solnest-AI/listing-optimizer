# Secrets & per-user config — never ship these (copy the .example files instead)
.env
branding.json
config/properties.json
config/memory.json
# ...and any backup/copy of them. The bare filenames above do NOT match
# `config/properties.json.bak`, which held real RankBreeze ids and would have been
# published by a `git add -A` into this PUBLIC repo. Caught 2026-09-20.
config/properties.json.*
config/memory.json.*
*.bak
*.bak-*
*.orig
*~

# Private planning docs (not part of the distributable tool)
LISTING-OPTIMIZER-BUILD-PLAN.md
SKOOL-POST.md

# Runtime / generated
.venv/
__pycache__/
*.pyc
output/
state/

# ===== BEGIN solnest-secrets-guard (added 2026-08-16) =====
# Keeps credentials out of git. Add your own rules BELOW this block.

# Environment files
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.*.example

# MCP / agent config (frequently holds inline API keys)
.mcp.json
.mcp.local.json
!.mcp.json.example
.claude.json
.claude/settings.local.json

# Keys & certificates
*.pem
*.p12
*.pfx
*.keystore
*.jks
*.ppk
id_rsa
id_rsa.*
id_ecdsa
id_ed25519

# Cloud / service-account credentials
credentials.json
client_secret*.json
service-account*.json
*-service-account.json
gha-creds-*.json
token.json
tokens.json
.netrc
.npmrc
.pypirc

# Local secret stores
secrets/
secrets.json
secrets.yml
secrets.yaml
*.secret

# Terraform (state and tfvars carry plaintext secrets)
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform/

# OS noise
.DS_Store
Thumbs.db
# ===== END solnest-secrets-guard =====
# Local code-intelligence tooling — NOT part of this tool and useless without the
# GitNexus MCP + a .gitnexus/ index. Its CLAUDE.md block contains MUST/NEVER rules that
# would order a fresh clone to call tools it does not have before editing anything.
.claude/skills/gitnexus/
AGENTS.md
.gitnexus/
